<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AndyOS // Personal Analytics Suite</title>
    <!-- Tailwind CSS Engine -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen antialiased">

    <!-- Top Premium Navigation Bar with Interactive Dropdown -->
    <nav class="border-b border-slate-800 bg-slate-900/80 backdrop-blur-md sticky top-0 z-50 px-6 py-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="h-9 w-9 bg-emerald-500 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/20">
                    <span class="text-slate-950 font-bold text-lg flex items-center justify-center h-full">A</span>
                </div>
                <h1 class="text-xl font-bold tracking-tight text-white">Andy<span class="text-emerald-400">OS</span></h1>
            </div>
            
            <!-- Interactive Dropdown Menu Shell -->
            <div class="relative inline-block text-left">
                <button onclick="toggleNavDropdown()" class="flex items-center space-x-2 text-sm text-slate-400 bg-slate-800/50 hover:bg-slate-800 hover:text-white px-4 py-2 rounded-full border border-slate-700/50 transition cursor-pointer">
                    <span class="h-2 w-2 bg-emerald-400 rounded-full animate-pulse"></span>
                    <span id="dropdown-label">System Views</span>
                    <!-- Down Arrow Icon -->
                    <svg class="w-4 h-4 ml-1 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>

                <!-- Floating Menu Panel -->
                <div id="nav-dropdown-menu" class="hidden absolute right-0 mt-2 w-48 rounded-xl bg-slate-800 border border-slate-700 shadow-2xl py-1 z-50 animate-in fade-in slide-in-from-top-2 duration-150">
                    <a href="#" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-slate-700 hover:text-white transition">📈 Core Metrics</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-slate-700 hover:text-white transition">📊 Biometric Charts</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-slate-700 hover:text-white transition">📝 Daily Notes</a>
                    <hr class="border-slate-700 my-1">
                    <div class="px-4 py-1.5 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Data Pipe</div>
                    <div class="px-4 py-1.5 text-xs text-emerald-400 flex items-center space-x-1.5">
                        <span class="h-1.5 w-1.5 bg-emerald-400 rounded-full"></span>
                        <span>Live Cloud Sync</span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- Phase 1: High-End KPI Executive Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 1: Net Wealth -->
            <div class="bg-slate-800/40 border border-slate-800 rounded-2xl p-6 backdrop-blur-sm shadow-xl hover:border-slate-700 transition duration-300">
                <p class="text-xs font-semibold tracking-wider text-slate-400 uppercase">Net Wealth Accumulation</p>
                <div class="flex items-baseline space-x-2 mt-2">
                    <span id="net-wealth" class="text-3xl font-bold tracking-tight text-white">Loading...</span>
                    <span class="text-xs font-medium text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md">Live</span>
                </div>
            </div>
            <!-- Card 2: Sleep Average -->
            <div class="bg-slate-800/40 border border-slate-800 rounded-2xl p-6 backdrop-blur-sm shadow-xl hover:border-slate-700 transition duration-300">
                <p class="text-xs font-semibold tracking-wider text-slate-400 uppercase">Weekly Sleep Efficiency</p>
                <div class="flex items-baseline space-x-2 mt-2">
                    <span id="sleep-efficiency" class="text-3xl font-bold tracking-tight text-white">Loading...</span>
                    <span class="text-xs font-medium text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md">Optimal</span>
                </div>
            </div>
            <!-- Card 3: Mood Baseline -->
            <div class="bg-slate-800/40 border border-slate-800 rounded-2xl p-6 backdrop-blur-sm shadow-xl hover:border-slate-700 transition duration-300">
                <p class="text-xs font-semibold tracking-wider text-slate-400 uppercase">Mental Baseline Score</p>
                <div class="flex items-baseline space-x-2 mt-2">
                    <span id="mood-score" class="text-3xl font-bold tracking-tight text-white">Loading...</span>
                    <span class="text-xs font-medium text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md">Peak</span>
                </div>
            </div>
        </div>

        <!-- Phase 2: Interactive 2x2 Grid Layout for All Charts -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-slate-800/20 border border-slate-800 rounded-2xl p-6 flex flex-col h-[480px]">
                <h3 class="text-md font-semibold text-white mb-4 flex items-center justify-between">
                    <span>Wealth Trajectory Tracking</span>
                    <span class="text-xs font-normal text-slate-500">Cumulative Progress</span>
                </h3>
                <div class="w-full flex-1 rounded-xl overflow-hidden bg-slate-900/50 border border-slate-800/80">
                    <iframe class="w-full h-full border-0 rounded-xl" src="https://docs.google.com/spreadsheets/d/e/2PACX-1vSqS2jPG6YAecLIr7ykDzqT0q0dHPgKLY0wFB1jWSxITjjv14vefNqI2bVHlv07KeEa-xWDBXisfnyx/pubchart?oid=1554213098&amp;format=interactive"></iframe>
                </div>
            </div>
            <div class="bg-slate-800/20 border border-slate-800 rounded-2xl p-6 flex flex-col h-[480px]">
                <h3 class="text-md font-semibold text-white mb-4 flex items-center justify-between">
                    <span>Biometric Baseline Tracker</span>
                    <span class="text-xs font-normal text-slate-500">Water Intake & Sleep Matrix</span>
                </h3>
                <div class="w-full flex-1 rounded-xl overflow-hidden bg-slate-900/50 border border-slate-800/80">
                    <iframe class="w-full h-full border-0 rounded-xl" src="https://docs.google.com/spreadsheets/d/e/2PACX-1vSqS2jPG6YAecLIr7ykDzqT0q0dHPgKLY0wFB1jWSxITjjv14vefNqI2bVHlv07KeEa-xWDBXisfnyx/pubchart?oid=525975851&amp;format=interactive"></iframe>
                </div>
            </div>
            <div class="bg-slate-800/20 border border-slate-800 rounded-2xl p-6 flex flex-col h-[480px]">
                <h3 class="text-md font-semibold text-white mb-4 flex items-center justify-between">
                    <span>Mindset Trend Mapping</span>
                    <span class="text-xs font-normal text-slate-500">Daily Mood Velocity</span>
                </h3>
                <div class="w-full flex-1 rounded-xl overflow-hidden bg-slate-900/50 border border-slate-800/80">
                    <iframe class="w-full h-full border-0 rounded-xl" src="https://docs.google.com/spreadsheets/d/e/2PACX-1vSqS2jPG6YAecLIr7ykDzqT0q0dHPgKLY0wFB1jWSxITjjv14vefNqI2bVHlv07KeEa-xWDBXisfnyx/pubchart?oid=643563304&amp;format=interactive"></iframe>
                </div>
            </div>
            <div class="bg-slate-800/20 border border-slate-800 rounded-2xl p-6 flex flex-col h-[480px]">
                <h3 class="text-md font-semibold text-white mb-4 flex items-center justify-between">
                    <span>Physical Composition Tracker</span>
                    <span class="text-xs font-normal text-slate-500">Weight Deltas</span>
                </h3>
                <div class="w-full flex-1 rounded-xl overflow-hidden bg-slate-900/50 border border-slate-800/80">
                    <iframe class="w-full h-full border-0 rounded-xl" src="https://docs.google.com/spreadsheets/d/e/2PACX-1vSqS2jPG6YAecLIr7ykDzqT0q0dHPgKLY0wFB1jWSxITjjv14vefNqI2bVHlv07KeEa-xWDBXisfnyx/pubchart?oid=654930680&amp;format=interactive"></iframe>
                </div>
            </div>
        </div>

        <!-- Phase 3: Targeted Rolling Log History Notes Panel -->
        <div class="bg-slate-800/20 border border-slate-800 rounded-2xl p-6">
            <h3 class="text-md font-semibold text-white mb-2">Recent Metric Logs & Deep Dives</h3>
            <p class="text-xs text-slate-400 mb-6">Displaying a live rolling scroll window of your spreadsheet's dedicated notes area.</p>
            <div class="rounded-xl overflow-hidden border border-slate-800 bg-white h-[180px]">
                <!-- Cropped exactly to log rows 40 to 44 across columns A and B -->
                <iframe class="w-full h-full border-0 invert" src="https://docs.google.com/spreadsheets/d/e/2PACX-1vSqS2jPG6YAecLIr7ykDzqT0q0dHPgKLY0wFB1jWSxITjjv14vefNqI2bVHlv07KeEa-xWDBXisfnyx/pubhtml?gid=1149740259&amp;single=true&amp;headers=false&amp;range=A40:B44"></iframe>
            </div>
        </div>
    </main>

    <!-- AUTOMATION DATA ENGINE SCRIPT -->
    <script>
        // Dropdown Click Handler Utilities
        function toggleNavDropdown() {
            const menu = document.getElementById('nav-dropdown-menu');
            menu.classList.toggle('hidden');
        }

        window.addEventListener('click', function(e) {
            const menu = document.getElementById('nav-dropdown-menu');
            if (!menu) return;
            const button = menu.previousElementSibling;
            if (!menu.contains(e.target) && !button.contains(e.target)) {
                menu.classList.add('hidden');
            }
        });

        // Core Live Sync Logic
        async function loadDashboardMetrics() {
            const csvUrl = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSqS2jPG6YAecLIr7ykDzqT0q0dHPgKLY0wFB1jWSxITjjv14vefNqI2bVHlv07KeEa-xWDBXisfnyx/pub?gid=1149740259&single=true&output=csv";
            
            try {
                const response = await fetch(csvUrl);
                if (!response.ok) throw new Error(`Status: ${response.status}`);
                const textData = await response.text();
                
                const lines = textData.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
                
                function getColumnValue(lineStr, colIndex) {
                    if (!lineStr) return "";
                    const cells = lineStr.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/);
                    const cell = cells[colIndex];
                    return cell ? cell.replace(/^"|"$/g, '').trim() : "";
                }

                // Extract absolute coordinates from Google Sheet feed (Column AB is index 27)
                const rawAB2 = lines[1] ? getColumnValue(lines[1], 27) : ""; 
                const rawAB3 = lines[2] ? getColumnValue(lines[2], 27) : ""; 
                const rawAB4 = lines[3] ? getColumnValue(lines[3], 27) : ""; 

                // Inject data cleanly into cards
                document.getElementById('net-wealth').innerText = rawAB2 || "$3,530.44";
                
                if (rawAB3) {
                    const cleanSleep = parseFloat(rawAB3.replace(/[^0-9.]/g, ''));
                    document.getElementById('sleep-efficiency').innerHTML = `${!isNaN(cleanSleep) ? cleanSleep.toFixed(1) : rawAB3} <span class="text-lg font-normal text-slate-500">hrs</span>`;
                } else {
                    document.getElementById('sleep-efficiency').innerText = "--";
                }
                
                if (rawAB4) {
                    const cleanMood = parseFloat(rawAB4.replace(/[^0-9.]/g, ''));
                    document.getElementById('mood-score').innerHTML = `${!isNaN(cleanMood) ? cleanMood.toFixed(1) : rawAB4} <span class="text-lg font-normal text-slate-500">/10</span>`;
                } else {
                    document.getElementById('mood-score').innerText = "--";
                }

            } catch (error) {
                console.error("Local file safety fallback engaged:", error);
                // Safe visual placeholders while working locally inside desktop sandbox
                document.getElementById('net-wealth').innerText = "$3,530.44";
                document.getElementById('sleep-efficiency').innerText = "Syncing...";
                document.getElementById('mood-score').innerText = "Syncing...";
            }
        }

        window.addEventListener('DOMContentLoaded', loadDashboardMetrics);
    </script>
</body>
</html>
